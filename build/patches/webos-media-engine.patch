+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef DOM_MEDIA_PLATFORMS_WEBOS_WEBOSENGINEDECODERMODULE_H_
+#define DOM_MEDIA_PLATFORMS_WEBOS_WEBOSENGINEDECODERMODULE_H_
+
+#include "PlatformDecoderModule.h"
+
+namespace mozilla {
+
+/**
+ * Content-process decoders for playback on the webOS media engine. They
+ * hand compressed samples to the WebOSEngineChannel named by the decoder
+ * params' media engine id and return placeholder output because the TV's
+ * pipeline decodes and shows the frames itself. Without an engine id the
+ * module declines, so ordinary playback never comes here.
+ */
+class WebOSEngineDecoderModule final : public PlatformDecoderModule {
+ public:
+  static already_AddRefed<PlatformDecoderModule> Create();
+
+  already_AddRefed<MediaDataDecoder> CreateVideoDecoder(
+      const CreateDecoderParams& aParams) override;
+  already_AddRefed<MediaDataDecoder> CreateAudioDecoder(
+      const CreateDecoderParams& aParams) override;
+
+  media::DecodeSupportSet SupportsMimeType(
+      const nsACString& aMimeType,
+      DecoderDoctorDiagnostics* aDiagnostics) const override;
+  media::DecodeSupportSet Supports(
+      const SupportDecoderParams& aParams,
+      DecoderDoctorDiagnostics* aDiagnostics) const override;
+
+  const char* Name() const override { return "WebOSEngine"; }
+
+ private:
+  WebOSEngineDecoderModule() = default;
+  ~WebOSEngineDecoderModule() = default;
+};
+
+}  // namespace mozilla
+
+#endif  // DOM_MEDIA_PLATFORMS_WEBOS_WEBOSENGINEDECODERMODULE_H_
