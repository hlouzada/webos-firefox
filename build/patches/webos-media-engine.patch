+#ifdef MOZ_WEBOS_MEDIA_ENGINE
+  // The TV's pipeline shows the frames on a plane under the window. Clear
+  // the window where the video is so that the plane shows through, and tell
+  // the element where that is on screen.
+  void PushPlaneHole(mozilla::wr::DisplayListBuilder& aBuilder,
+                     HTMLVideoElement* aElement) {
+    auto* f = static_cast<nsVideoFrame*>(Frame());
+    if (aElement->GetVideoSize().isNothing()) {
+      aElement->NotifyVideoPlaneRect(gfx::IntRect());
+      return;
+    }
+    nsRect destInFrame = f->GetDestRect(f->GetContentRectRelativeToSelf());
+    nsPresContext* pc = f->PresContext();
+    gfxRect destGfx =
+        pc->AppUnitsToGfxUnits(destInFrame + ToReferenceFrame());
+    destGfx.Round();
+    if (destGfx.IsEmpty()) {
+      aElement->NotifyVideoPlaneRect(gfx::IntRect());
+      return;
+    }
+    LayoutDeviceRect rect(destGfx.x, destGfx.y, destGfx.width,
+                          destGfx.height);
+    aBuilder.PushClearRect(wr::ToLayoutRect(rect), wr::ToLayoutRect(rect),
+                           !BackfaceIsHidden());
+
+    // On screen this is the frame's own place plus the dest rect inside it.
+    nsRect onScreen = destInFrame + f->GetScreenRectInAppUnits().TopLeft();
+    LayoutDeviceIntRect dev = LayoutDeviceIntRect::FromAppUnitsToNearest(
+        onScreen, pc->AppUnitsPerDevPixel());
+    aElement->NotifyVideoPlaneRect(
+        gfx::IntRect(dev.x, dev.y, dev.width, dev.height));
+  }
+#endif
+
   // For opaque videos, we will want to override GetOpaqueRegion here.
   // This is tracked by bug 1545498.
 
