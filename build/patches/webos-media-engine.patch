+
+static LazyLogModule sWebOSEngineLog("WebOSEngine");
+#define LOG(fmt, ...)                                             \
+  MOZ_LOG(sWebOSEngineLog, LogLevel::Debug,                       \
+          ("WebOSEngine %" PRIu64 ": " fmt, mId, ##__VA_ARGS__))
+#define LOGW(fmt, ...)                                           \
+  MOZ_LOG(sWebOSEngineLog, LogLevel::Warning,                    \
+          ("WebOSEngine %" PRIu64 ": " fmt, mId, ##__VA_ARGS__))
+
+// Wire format shared with the helper, src/media-protocol.h in the app
+// repository. Keep the two in step.
+namespace {
+
+constexpr uint32_t kMagic = 0x4d565447u;
+constexpr uint32_t kMaxPayload = 16u * 1024u * 1024u;
+constexpr int kHelperFd = 3;
+
+enum MsgType : uint32_t {
+  GM_REPLY = 2,
+  GM_OPEN = 10,
+  GM_LOAD = 11,
+  GM_FEED = 12,
+  GM_SEEK = 13,
+  GM_PLAY = 14,
+  GM_PAUSE = 15,
+  GM_VOLUME = 16,
+  GM_EOS = 17,
+  GM_STATUS = 19,
+  GM_CLOSE = 20,
+};
+enum { GM_TRACK_VIDEO = 1, GM_TRACK_AUDIO = 2 };
+enum { GM_VIDEO_H264 = 1, GM_VIDEO_VP9 = 2 };
+enum { GM_AUDIO_NONE = 0, GM_AUDIO_AAC = 3 };
+enum { GM_OK = 0, GM_RETRY = 1, GM_UNSUPPORTED = 2, GM_ERROR = -1 };
+enum {
+  GM_F_PIPELINE = 1,
+  GM_F_LOADED = 2,
+  GM_F_HAS_FRAME = 4,
+  GM_F_ENDED = 8,
+  GM_F_FAILED = 16,
+  GM_F_SEEKDONE = 32,
+  GM_F_PLAYING = 64,
+};
+
+struct OpenPayload {
+  uint32_t audio_rate;
+  uint32_t audio_channels;
+  uint32_t audio_profile;
+  uint32_t audio_frequency_index;
+  char window_id[128];
+};
+
+constexpr int kTickMs = 25;
+constexpr int kReplyTimeoutMs = 3000;
+constexpr int kOpenTimeoutMs = 10000;
+constexpr int kTimeupdateIntervalUs = 100000;
+
+StaticMutex sChannelsMutex;
+std::map<uint64_t, WebOSEngineChannel*>* sChannels = nullptr;
+Atomic<uint64_t> sNextId(1);
+
+}  // namespace
+
+struct WebOSEngineChannel::Msg {
+  uint32_t magic;
+  uint32_t type;
+  uint32_t size;
+  uint32_t reserved;
+  int32_t arg[6];
+  int64_t time_us;
+};
+
+/* static */
+bool WebOSEngine::IsAvailable() {
+  const char* helper = getenv("GECKOTV_MEDIA_HELPER");
+  return StaticPrefs::media_webos_engine_enabled() && helper && helper[0];
+}
+
+/* static */
+bool WebOSEngine::SupportsFormat(const MediaInfo& aInfo) {
+  if (!aInfo.HasVideo() || aInfo.IsEncrypted()) {
+    return false;
+  }
+  const nsCString& v = aInfo.mVideo.mMimeType;
+  if (!MP4Decoder::IsH264(v) && !VPXDecoder::IsVP9(v)) {
+    return false;
+  }
+  if (aInfo.HasAudio() && !MP4Decoder::IsAAC(aInfo.mAudio.mMimeType)) {
+    return false;
+  }
+  return true;
+}
+
+/* static */
+bool WebOSEngine::SupportsCodecs(const MediaCodecs& aCodecs) {
+  for (const auto& codec : aCodecs.Range()) {
+    if (!IsH264CodecString(codec) && !IsVP9CodecString(codec) &&
+        !IsAACCodecString(codec)) {
+      return false;
+    }
+  }
+  return true;
+}
