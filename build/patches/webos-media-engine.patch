+/// A rectangle that clears the window to transparent where it lies
+/// (PrimitiveFlags::IS_CUTOUT). It is the hole a video shows through when it
+/// plays on a hardware plane under the window.
+#[no_mangle]
+pub extern "C" fn wr_dp_push_clear_rect(
+    state: &mut WrState,
+    rect: LayoutRect,
+    clip: LayoutRect,
+    is_backface_visible: bool,
+    parent: &WrSpaceAndClipChain,
+) {
+    debug_assert!(unsafe { !is_in_render_thread() });
+
+    let mut prim_info = common_item_properties_for_rect(state, clip, is_backface_visible, parent);
+    prim_info.flags |= PrimitiveFlags::IS_CUTOUT;
+
+    // Opaque black, because the colour's alpha is what dest-out removes.
+    state.frame_builder.dl_builder.push_rect(&prim_info, rect, ColorF::BLACK);
+}
