+WebOSEngine::WebOSEngine(ExternalEngineStateMachine* aOwner)
+    : ExternalPlaybackEngine(aOwner), mChannel(new WebOSEngineChannel(aOwner)) {}
+
+WebOSEngine::~WebOSEngine() { mChannel->Shutdown(); }
+
+RefPtr<GenericNonExclusivePromise> WebOSEngine::Init(
+    const MediaInfo& aInfo, const InitFlagSet& aFlags) {
+  return mChannel->Init(aInfo);
+}
+
+void WebOSEngine::Shutdown() { mChannel->Shutdown(); }
+
+WebOSEngineChannel::WebOSEngineChannel(ExternalEngineStateMachine* aOwner)
+    : mId(sNextId++),
+      mOwner(aOwner),
+      mTaskQueue(TaskQueue::Create(
+          GetMediaThreadPool(MediaThreadType::PLATFORM_DECODER),
+          "WebOSEngineChannel")),
+      mTimer(new MediaTimer<TimeStamp>()) {
+  StaticMutexAutoLock lock(sChannelsMutex);
+  if (!sChannels) {
+    sChannels = new std::map<uint64_t, WebOSEngineChannel*>();
+  }
+  (*sChannels)[mId] = this;
+}
+
+WebOSEngineChannel::~WebOSEngineChannel() {
+  Close();
+  StaticMutexAutoLock lock(sChannelsMutex);
+  if (sChannels) {
+    sChannels->erase(mId);
+  }
+}
+
+/* static */
+RefPtr<WebOSEngineChannel> WebOSEngineChannel::FromId(uint64_t aId) {
+  StaticMutexAutoLock lock(sChannelsMutex);
+  if (!sChannels) {
+    return nullptr;
+  }
+  auto it = sChannels->find(aId);
+  return it == sChannels->end() ? nullptr : RefPtr{it->second};
+}
+
+void WebOSEngineChannel::NotifyOwner(ExternalEngineEvent aEvent) {
+  if (!mOwnerGone) {
+    mOwner->NotifyEvent(aEvent);
+  }
+}
+
+RefPtr<GenericNonExclusivePromise> WebOSEngineChannel::Init(
+    const MediaInfo& aInfo) {
+  mInfo = aInfo;
+  return InvokeAsync(mTaskQueue, __func__, [self = RefPtr{this}, this] {
+    if (!Spawn()) {
+      return GenericNonExclusivePromise::CreateAndReject(NS_ERROR_FAILURE,
+                                                          __func__);
+    }
+    ConnectAdapter();
+    if (!Open()) {
+      Close();
+      return GenericNonExclusivePromise::CreateAndReject(NS_ERROR_FAILURE,
+                                                          __func__);
+    }
+    RefPtr<gfx::DataSourceSurface> surface =
+        gfx::Factory::CreateDataSourceSurface(gfx::IntSize(2, 2),
+                                              gfx::SurfaceFormat::B8G8R8A8,
+                                              /* aZero */ true);
+    if (surface) {
+      mImage = new layers::SourceSurfaceImage(surface);
+    }
+    mInited = true;
+    LOG("helper %d ready, window %s", int(mPid), mWindowId.get());
+    ScheduleTick();
+    return GenericNonExclusivePromise::CreateAndResolve(true, __func__);
+  });
+}
+
+// The helper loads the TV's own libraries, so it gets no LD_LIBRARY_PATH or
+// LD_PRELOAD from Firefox's runtime, only the variables it reads.
+bool WebOSEngineChannel::Spawn() {
+  const char* helper = getenv("GECKOTV_MEDIA_HELPER");
+  if (!helper || !helper[0]) {
+    return false;
+  }
+  int sv[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) != 0) {
+    LOGW("socketpair: %s", strerror(errno));
+    return false;
+  }
+  nsTArray<nsCString> env;
+  static const char* const kPass[] = {"APPID", "HOME", "XDG_RUNTIME_DIR",
+                                      "WAYLAND_DISPLAY"};
+  for (const char* name : kPass) {
+    if (const char* v = getenv(name)) {
+      env.AppendElement(nsPrintfCString("%s=%s", name, v));
+    }
+  }
+  for (char** e = environ; e && *e; e++) {
+    if (!strncmp(*e, "GECKOTV_MEDIA_LOG=", 18)) {
+      env.AppendElement(nsCString(*e));
+    }
+  }
+  nsTArray<char*> envp;
+  for (nsCString& e : env) {
+    envp.AppendElement(e.BeginWriting());
+  }
+  envp.AppendElement(nullptr);
+  char* const argv[] = {const_cast<char*>(helper),
+                        const_cast<char*>("--media-helper"), nullptr};
+  struct rlimit nofile;
+  int maxFd = 1024;
+  if (getrlimit(RLIMIT_NOFILE, &nofile) == 0 && nofile.rlim_cur != RLIM_INFINITY) {
+    maxFd = int(std::min<rlim_t>(nofile.rlim_cur, 65536));
+  }
+
+  pid_t pid = fork();
+  if (pid < 0) {
+    LOGW("fork: %s", strerror(errno));
+    close(sv[0]);
+    close(sv[1]);
+    return false;
+  }
+  if (pid == 0) {
+    // In the child only async-signal-safe calls are allowed until execve.
+    if (sv[1] == kHelperFd) {
+      fcntl(kHelperFd, F_SETFD, 0);
+    } else if (dup2(sv[1], kHelperFd) < 0) {
+      _exit(126);
+    }
+    for (int fd = kHelperFd + 1; fd < maxFd; fd++) {
+      close(fd);
+    }
+    signal(SIGPIPE, SIG_DFL);
+    sigset_t none;
+    sigemptyset(&none);
+    sigprocmask(SIG_SETMASK, &none, nullptr);
+    execve(helper, argv, envp.Elements());
+    _exit(127);
+  }
+  close(sv[1]);
+  mFd = sv[0];
+  mPid = pid;
+  LOG("helper %s started as pid %d", helper, int(pid));
+  return true;
+}
+
+// The adapter in the parent process exports a region of the window for
+// the video plane. It tells us the exported window's id and takes the
+// video's rectangle. Without it the pipeline has no place to show the
+// picture, which is not fatal.
+void WebOSEngineChannel::ConnectAdapter() {
+  const char* path = getenv("GECKOTV_VIDEO_SOCKET");
+  struct sockaddr_un addr;
+  if (!path || !path[0] || strlen(path) >= sizeof addr.sun_path) {
+    return;
+  }
+  int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+  if (fd < 0) {
+    return;
+  }
+  memset(&addr, 0, sizeof addr);
+  addr.sun_family = AF_UNIX;
+  strcpy(addr.sun_path, path);
+  if (connect(fd, reinterpret_cast<struct sockaddr*>(&addr), sizeof addr) != 0) {
+    LOGW("adapter socket %s: %s", path, strerror(errno));
+    close(fd);
+    return;
+  }
+  struct ucred cred;
+  socklen_t len = sizeof cred;
+  if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cred, &len) != 0 ||
+      cred.uid != getuid()) {
+    LOGW("adapter socket belongs to another user");
+    close(fd);
+    return;
+  }
+  // The window id comes right after the connection is accepted.
+  char buf[256];
+  size_t have = 0;
+  TimeStamp deadline = TimeStamp::Now() + TimeDuration::FromSeconds(2);
+  while (have < sizeof buf - 1) {
+    struct pollfd pfd = {fd, POLLIN, 0};
+    double left = (deadline - TimeStamp::Now()).ToMilliseconds();
+    if (left <= 0 || poll(&pfd, 1, int(left)) <= 0) {
+      break;
+    }
+    ssize_t n = read(fd, buf + have, sizeof buf - 1 - have);
+    if (n <= 0) {
+      break;
+    }
+    have += size_t(n);
+    buf[have] = '\0';
+    char* nl = strchr(buf, '\n');
+    if (nl) {
+      *nl = '\0';
+      if (!strncmp(buf, "windowid ", 9)) {
+        mWindowId.Assign(buf + 9);
+      }
+      break;
+    }
+  }
+  if (mWindowId.IsEmpty()) {
+    LOGW("no exported window id from the adapter");
+  }
+  mAdapterFd = fd;
+}
+
+void WebOSEngineChannel::SendAdapterRect(const gfx::IntRect& aRect) {
+  if (mAdapterFd < 0) {
+    return;
+  }
+  nsPrintfCString line("rect %d %d %d %d %d %d\n", aRect.x, aRect.y,
+                       aRect.width, aRect.height, mInfo.mVideo.mDisplay.width,
+                       mInfo.mVideo.mDisplay.height);
+  if (send(mAdapterFd, line.get(), line.Length(), MSG_NOSIGNAL | MSG_DONTWAIT) <
+      0) {
+    LOGW("adapter link lost: %s", strerror(errno));
+    close(mAdapterFd);
+    mAdapterFd = -1;
+  }
+}
+
+bool WebOSEngineChannel::Open() {
+  const VideoInfo& v = mInfo.mVideo;
+  Msg m{};
+  m.type = GM_OPEN;
+  m.arg[0] = MP4Decoder::IsH264(v.mMimeType) ? GM_VIDEO_H264 : GM_VIDEO_VP9;
+  m.arg[1] = v.mImage.width;
+  m.arg[2] = v.mImage.height;
+  // The frame rate is refined from the first samples at LOAD time, so the
+  // helper only validates it here.
+  m.arg[3] = 30;
+  m.arg[4] = 1;
+  OpenPayload p{};
+  if (mInfo.HasAudio()) {
+    const AudioInfo& a = mInfo.mAudio;
+    m.arg[5] = GM_AUDIO_AAC;
+    p.audio_rate = a.mRate;
+    p.audio_channels = a.mChannels;
+    p.audio_profile = a.mProfile ? a.mProfile : 2;
+    auto index = ADTS::GetFrequencyIndex(a.mRate);
+    if (index.isErr()) {
+      LOGW("AAC rate %u has no ADTS index", a.mRate);
+      return false;
+    }
+    p.audio_frequency_index = index.unwrap();
+  } else {
+    m.arg[5] = GM_AUDIO_NONE;
+  }
+  snprintf(p.window_id, sizeof p.window_id, "%s", mWindowId.get());
+  if (!Request(m, &p, sizeof p, kOpenTimeoutMs)) {
+    LOGW("helper did not answer OPEN");
+    return false;
+  }
+  if (m.arg[0] != GM_OK) {
+    LOGW("helper refused the stream (%d)", m.arg[0]);
+    return false;
+  }
+  return true;
+}
+
+bool WebOSEngineChannel::SendAll(const void* aData, size_t aLen,
+                                 const TimeStamp& aDeadline) {
+  const uint8_t* p = static_cast<const uint8_t*>(aData);
+  while (aLen) {
+    struct pollfd pfd = {mFd, POLLOUT, 0};
+    double left = (aDeadline - TimeStamp::Now()).ToMilliseconds();
+    if (left <= 0 || poll(&pfd, 1, int(left)) <= 0) {
+      return false;
+    }
+    ssize_t n = send(mFd, p, aLen, MSG_NOSIGNAL | MSG_DONTWAIT);
+    if (n < 0) {
+      if (errno == EINTR || errno == EAGAIN) {
+        continue;
+      }
+      return false;
+    }
+    p += n;
+    aLen -= size_t(n);
+  }
+  return true;
+}
+
+bool WebOSEngineChannel::RecvAll(void* aData, size_t aLen,
+                                 const TimeStamp& aDeadline) {
+  uint8_t* p = static_cast<uint8_t*>(aData);
+  while (aLen) {
+    struct pollfd pfd = {mFd, POLLIN, 0};
+    double left = (aDeadline - TimeStamp::Now()).ToMilliseconds();
+    if (left <= 0 || poll(&pfd, 1, int(left)) <= 0) {
+      return false;
+    }
+    ssize_t n = recv(mFd, p, aLen, MSG_DONTWAIT);
+    if (n == 0) {
+      return false;
+    }
+    if (n < 0) {
+      if (errno == EINTR || errno == EAGAIN) {
+        continue;
+      }
+      return false;
+    }
+    p += n;
+    aLen -= size_t(n);
+  }
+  return true;
+}
+
+// Sends one request and waits for the reply that replaces aMsg. A
+// missing or malformed reply within the timeout is a dead helper.
+bool WebOSEngineChannel::Request(Msg& aMsg, const void* aPayload, size_t aSize,
+                                 int aTimeoutMs) {
+  if (mFd < 0 || aSize > kMaxPayload) {
+    return false;
+  }
+  aMsg.magic = kMagic;
+  aMsg.size = uint32_t(aSize);
+  mRequestsThisTick++;
+  TimeStamp deadline =
+      TimeStamp::Now() + TimeDuration::FromMilliseconds(aTimeoutMs);
+  if (!SendAll(&aMsg, sizeof aMsg, deadline) ||
+      (aSize && !SendAll(aPayload, aSize, deadline))) {
+    return false;
+  }
+  Msg reply;
+  if (!RecvAll(&reply, sizeof reply, deadline)) {
+    return false;
+  }
+  if (reply.magic != kMagic || reply.type != GM_REPLY || reply.size != 0) {
+    LOGW("malformed reply");
+    return false;
+  }
+  aMsg = reply;
+  return true;
+}
+
+void WebOSEngineChannel::ScheduleTick() {
+  if (mClosed) {
+    return;
+  }
+  mTimer->WaitFor(TimeDuration::FromMilliseconds(kTickMs), __func__)
+      ->Then(
+          mTaskQueue, __func__,
+          [self = RefPtr{this}, this](bool) {
+            mTickRequest.Complete();
+            Tick();
+          },
+          [self = RefPtr{this}, this](bool) { mTickRequest.Complete(); })
+      ->Track(mTickRequest);
+}
+
+int64_t WebOSEngineChannel::LeadUs() const {
+  return int64_t(mHasFrameSinceLoad ? StaticPrefs::media_webos_engine_lead_ms()
+                                    : StaticPrefs::media_webos_engine_preroll_ms()) *
+         1000;
+}
+
+// Loads the pipeline once the first video sample is here and hands over
+// the samples whose time has come. Runs when a sample arrives and on
+// every tick, so the pipeline's clock sets the pace rather than the tick.
+bool WebOSEngineChannel::Pump() {
+  if (!mPipelineRequested && mVideo.mSample && !SendLoad()) {
+    return false;
+  }
+  if (!mPipelineRequested) {
+    return true;
+  }
+  return FeedOne(mVideo, TrackInfo::kVideoTrack) &&
+         FeedOne(mAudio, TrackInfo::kAudioTrack) &&
+         SendEos(mVideo, TrackInfo::kVideoTrack) &&
+         SendEos(mAudio, TrackInfo::kAudioTrack);
+}
+
+// Every 25 ms releases the samples held back for the lead and reads the
+// pipeline's state from a reply.
+void WebOSEngineChannel::Tick() {
+  if (mClosed || mFatal) {
+    return;
+  }
+  mRequestsThisTick = 0;
+  if (!Pump()) {
+    return;
+  }
+  if (mRequestsThisTick == 0) {
+    Msg m{};
+    m.type = GM_STATUS;
+    if (!Request(m, nullptr, 0, kReplyTimeoutMs)) {
+      Fail(MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                       RESULT_DETAIL("webOS helper stopped answering")));
+      return;
+    }
+    HandleReply(m);
+  }
+  if (mRectSent == false && !mRect.IsEmpty()) {
+    SendAdapterRect(mRect);
+    mRectSent = true;
+  }
+  ScheduleTick();
+}
+
+bool WebOSEngineChannel::SendLoad() {
+  const MediaRawData& s = *mVideo.mSample;
+  Msg m{};
+  m.type = GM_LOAD;
+  m.time_us = mLoadTimeUs;
+  // The open declared 30 fps but the real rate is in the sample durations.
+  // The pipeline judders when told a rate above the stream's.
+  m.arg[0] = 30000;
+  m.arg[1] = 1000;
+  if (s.mDuration.IsValid() && s.mDuration.ToMicroseconds() > 0) {
+    int32_t fps = int32_t(std::lround(1e9 / double(s.mDuration.ToMicroseconds())));
+    if (fps >= 1000 && fps <= 120000) {
+      m.arg[0] = fps;
+    }
+  }
+  LOG("LOAD at %" PRId64 " us, %d/1000 fps", mLoadTimeUs, m.arg[0]);
+  if (!Request(m, nullptr, 0, kReplyTimeoutMs)) {
+    Fail(MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                     RESULT_DETAIL("webOS helper stopped answering LOAD")));
+    return false;
+  }
+  mPipelineRequested = true;
+  mHasFrameSinceLoad = false;
+  mVideo.mEosSent = mAudio.mEosSent = false;
+  HandleReply(m);
+  return !mFatal;
+}
+
+// One sample at most waits per track and goes out once its time is within
+// the lead of the pipeline's clock. BufferFull keeps it for the next tick.
+bool WebOSEngineChannel::FeedOne(Track& aTrack, TrackInfo::TrackType aType) {
+  if (!aTrack.mSample) {
+    return true;
+  }
+  const MediaRawData& s = *aTrack.mSample;
+  int64_t pts = s.mTime.ToMicroseconds();
+  if (pts > mPositionUs + LeadUs()) {
+    return true;
+  }
+  Msg m{};
+  m.type = GM_FEED;
+  m.arg[0] = aType == TrackInfo::kVideoTrack ? GM_TRACK_VIDEO : GM_TRACK_AUDIO;
+  m.arg[1] = s.mKeyframe;
+  m.time_us = pts;
+  if (!Request(m, s.Data(), s.Size(), kReplyTimeoutMs)) {
+    Fail(MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                     RESULT_DETAIL("webOS helper stopped answering FEED")));
+    return false;
+  }
+  int result = m.arg[0];
+  HandleReply(m);
+  if (mFatal) {
+    return false;
+  }
+  if (result == GM_RETRY) {
+    return true;
+  }
+  if (result != GM_OK) {
+    Fail(MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                     RESULT_DETAIL("webOS pipeline refused a sample")));
+    return false;
+  }
+  aTrack.mLastFedUs = pts;
+  RefPtr<MediaData> out = FakeOutput(aType, s);
+  aTrack.mSample = nullptr;
+  MediaDataDecoder::DecodedData outputs;
+  if (out) {
+    outputs.AppendElement(out);
+  }
+  aTrack.mPromise.ResolveIfExists(std::move(outputs), __func__);
+  return true;
+}
+
+bool WebOSEngineChannel::SendEos(Track& aTrack, TrackInfo::TrackType aType) {
+  if (!aTrack.mEnded || aTrack.mEosSent || aTrack.mSample) {
+    return true;
+  }
+  Msg m{};
+  m.type = GM_EOS;
+  m.arg[0] = aType == TrackInfo::kVideoTrack ? GM_TRACK_VIDEO : GM_TRACK_AUDIO;
+  if (!Request(m, nullptr, 0, kReplyTimeoutMs)) {
+    Fail(MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                     RESULT_DETAIL("webOS helper stopped answering EOS")));
+    return false;
+  }
+  aTrack.mEosSent = true;
+  HandleReply(m);
+  return !mFatal;
+}
+
+already_AddRefed<MediaData> WebOSEngineChannel::FakeOutput(
+    TrackInfo::TrackType aType, const MediaRawData& aSample) {
+  if (aType == TrackInfo::kVideoTrack) {
+    if (!mImage) {
+      return nullptr;
+    }
+    RefPtr<VideoData> v = VideoData::CreateFromImage(
+        mInfo.mVideo.mDisplay, aSample.mOffset, aSample.mTime,
+        aSample.mDuration, mImage, aSample.mKeyframe, aSample.mTimecode);
+    return v.forget();
+  }
+  RefPtr<MediaData> a =
+      new AudioData(aSample.mOffset, aSample.mTime, AlignedAudioBuffer{},
+                    mInfo.mAudio.mChannels, mInfo.mAudio.mRate);
+  return a.forget();
+}
+
+// The pipeline's state travels in every reply.
+void WebOSEngineChannel::HandleReply(const Msg& aReply) {
+  int flags = aReply.arg[1];
+  int before = mLastFlags;
+  mLastFlags = flags;
+  if (flags & GM_F_FAILED) {
+    LOGW("pipeline failed (error %d), loaded before: %d", aReply.arg[2],
+         mEverLoaded);
+    // Before the first load the TV may just have no decoder for us, and
+    // Firefox then plays in software. Afterwards the stream is lost.
+    Fail(MediaResult(mEverLoaded ? NS_ERROR_DOM_MEDIA_DECODE_ERR
+                                 : NS_ERROR_DOM_MEDIA_NOT_SUPPORTED_ERR,
+                     RESULT_DETAIL("webOS pipeline error %d", aReply.arg[2])));
+    return;
+  }
+  if (!(flags & GM_F_PIPELINE) && (before & GM_F_PIPELINE)) {
+    // The helper unloaded after a refused seek, so load again at the position.
+    LOG("pipeline gone, reloading at %" PRId64, int64_t(mPositionUs));
+    mPipelineRequested = false;
+    mLoadTimeUs = mPositionUs;
+    mHasFrameSinceLoad = false;
+  }
+  if ((flags & GM_F_LOADED) && !(before & GM_F_LOADED)) {
+    mEverLoaded = true;
+    if (!mLoadedReported) {
+      mLoadedReported = true;
+      NotifyOwner(ExternalEngineEvent::LoadedData);
+    }
+  }
+  if (flags & GM_F_HAS_FRAME) {
+    mHasFrameSinceLoad = true;
+    int64_t t = aReply.time_us;
+    if (mVideo.mLastFedUs >= 0 && t > mVideo.mLastFedUs) {
+      t = mVideo.mLastFedUs;
+    }
+    if (t != mPositionUs) {
+      mPositionUs = t;
+    }
+  }
+  if (mPositionUs != mLastTimeupdateUs &&
+      (mLastTimeupdateUs < 0 ||
+       std::abs(mPositionUs - mLastTimeupdateUs) >= kTimeupdateIntervalUs)) {
+    mLastTimeupdateUs = mPositionUs;
+    NotifyOwner(ExternalEngineEvent::Timeupdate);
+  }
+  if ((flags & GM_F_ENDED) && !mEndedReported) {
+    mEndedReported = true;
+    NotifyOwner(ExternalEngineEvent::Ended);
+  }
+}
+
+void WebOSEngineChannel::Fail(const MediaResult& aError) {
+  if (mFatal) {
+    return;
+  }
+  mFatal = true;
+  LOGW("%s", aError.Description().get());
+  RejectPending(mVideo);
+  RejectPending(mAudio);
+  if (!mOwnerGone) {
+    mOwner->NotifyError(aError);
+  }
+}
+
+void WebOSEngineChannel::RejectPending(Track& aTrack) {
+  aTrack.mSample = nullptr;
+  aTrack.mPromise.RejectIfExists(NS_ERROR_DOM_MEDIA_CANCELED, __func__);
+}
+
+void WebOSEngineChannel::Shutdown() {
+  mOwnerGone = true;
+  mInited = false;
+  (void)mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "WebOSEngineChannel::Shutdown", [self = RefPtr{this}, this] {
+        Close();
+        mTaskQueue->BeginShutdown();
+      }));
+}
+
+// Tells the helper to unload, then makes sure it is gone. A helper stuck
+// inside LG's library is killed by a thread that never blocks this queue.
+void WebOSEngineChannel::Close() {
+  if (mClosed) {
+    return;
+  }
+  mClosed = true;
+  mTickRequest.DisconnectIfExists();
+  mTimer->Cancel();
+  RejectPending(mVideo);
+  RejectPending(mAudio);
+  if (mFd >= 0) {
+    Msg m{};
+    m.type = GM_CLOSE;
+    Request(m, nullptr, 0, 500);
+    close(mFd);
+    mFd = -1;
+  }
+  if (mAdapterFd >= 0) {
+    close(mAdapterFd);
+    mAdapterFd = -1;
+  }
+  if (mPid > 0) {
+    pid_t pid = mPid;
+    mPid = 0;
+    std::thread([pid] {
+      for (int i = 0; i < 40; i++) {
+        int status;
+        if (waitpid(pid, &status, WNOHANG) != 0) {
+          return;
+        }
+        usleep(50 * 1000);
+      }
+      kill(pid, SIGKILL);
+      int status;
+      waitpid(pid, &status, 0);
+    }).detach();
+  }
+}
+
+void WebOSEngineChannel::Play() {
+  (void)mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "WebOSEngineChannel::Play", [self = RefPtr{this}, this] {
+        if (mClosed || mFatal) {
+          return;
+        }
+        mPlaying = true;
+        Msg m{};
+        m.type = GM_PLAY;
+        if (Request(m, nullptr, 0, kReplyTimeoutMs)) {
+          HandleReply(m);
+        }
+      }));
+}
+
+void WebOSEngineChannel::Pause() {
+  (void)mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "WebOSEngineChannel::Pause", [self = RefPtr{this}, this] {
+        if (mClosed || mFatal) {
+          return;
+        }
+        mPlaying = false;
+        Msg m{};
+        m.type = GM_PAUSE;
+        if (Request(m, nullptr, 0, kReplyTimeoutMs)) {
+          HandleReply(m);
+        }
+      }));
+}
+
+// The clock jumps to the target at once. The state machine resets the
+// reader and the reader's flush drops the samples that wait here. Samples
+// from the target follow. The helper flushes its pipeline and starts a new
+// segment at the first sample it gets.
+void WebOSEngineChannel::Seek(const media::TimeUnit& aTarget) {
+  int64_t target = aTarget.ToMicroseconds();
+  mPositionUs = target;
+  (void)mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "WebOSEngineChannel::Seek", [self = RefPtr{this}, this, target] {
+        if (mClosed || mFatal) {
+          return;
+        }
+        mPositionUs = target;
+        mLoadTimeUs = target;
+        mHasFrameSinceLoad = false;
+        mEndedReported = false;
+        mVideo.mEnded = mAudio.mEnded = false;
+        mVideo.mEosSent = mAudio.mEosSent = false;
+        mVideo.mLastFedUs = mAudio.mLastFedUs = -1;
+        // The samples that wait here are from before the target, and their
+        // promises stay pending until the reader flushes the decoders. A
+        // rejection sent now can reach the reader before its flush, and it
+        // then keeps the cancel as a fatal error that silently stops the seek.
+        mVideo.mSample = nullptr;
+        mAudio.mSample = nullptr;
+        Msg m{};
+        m.type = GM_SEEK;
+        m.time_us = target;
+        if (!Request(m, nullptr, 0, kReplyTimeoutMs)) {
+          Fail(MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                           RESULT_DETAIL("webOS helper stopped answering SEEK")));
+          return;
+        }
+        HandleReply(m);
+        NotifyOwner(ExternalEngineEvent::Seeked);
+      }));
+}
+
+// The pipeline plays at one speed when fed this way. Another rate is
+// refused, so Firefox continues in software at the position.
+void WebOSEngineChannel::SetPlaybackRate(double aRate) {
+  if (aRate == 1.0 || aRate == 0.0) {
+    return;
+  }
+  (void)mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "WebOSEngineChannel::SetPlaybackRate", [self = RefPtr{this}, this] {
+        if (mClosed || mFatal) {
+          return;
+        }
+        Fail(MediaResult(NS_ERROR_DOM_MEDIA_NOT_SUPPORTED_ERR,
+                         RESULT_DETAIL("playback rate on the webOS pipeline")));
+      }));
+}
+
+void WebOSEngineChannel::SetVolume(double aVolume) {
+  int volume = int(std::lround(std::clamp(aVolume, 0.0, 1.0) * 100));
+  (void)mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "WebOSEngineChannel::SetVolume", [self = RefPtr{this}, this, volume] {
+        if (mClosed || mFatal) {
+          return;
+        }
+        Msg m{};
+        m.type = GM_VOLUME;
+        m.arg[0] = volume;
+        if (Request(m, nullptr, 0, kReplyTimeoutMs)) {
+          HandleReply(m);
+        }
+      }));
+}
+
+void WebOSEngineChannel::NotifyEndOfStream(TrackInfo::TrackType aType) {
+  (void)mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "WebOSEngineChannel::NotifyEndOfStream",
+      [self = RefPtr{this}, this, aType] {
+        if (mClosed) {
+          return;
+        }
+        TrackFor(aType).mEnded = true;
+      }));
+}
+
+void WebOSEngineChannel::SetVideoRect(const gfx::IntRect& aRect) {
+  (void)mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "WebOSEngineChannel::SetVideoRect", [self = RefPtr{this}, this, aRect] {
+        if (mClosed || aRect == mRect) {
+          return;
+        }
+        mRect = aRect;
+        mRectSent = false;
+        SendAdapterRect(aRect);
+        mRectSent = true;
+      }));
+}
+
+RefPtr<WebOSEngineChannel::DecodePromise> WebOSEngineChannel::Submit(
+    TrackInfo::TrackType aType, RefPtr<MediaRawData> aSample) {
+  return InvokeAsync(
+      mTaskQueue, __func__,
+      [self = RefPtr{this}, this, aType, sample = std::move(aSample)]() mutable
+          -> RefPtr<DecodePromise> {
+        if (mClosed || mFatal) {
+          return DecodePromise::CreateAndReject(
+              MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                          RESULT_DETAIL("webOS engine is gone")),
+              __func__);
+        }
+        Track& track = TrackFor(aType);
+        if (track.mSample) {
+          // The reader keeps one decode in flight per track.
+          return DecodePromise::CreateAndReject(
+              MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                          RESULT_DETAIL("sample submitted while one waits")),
+              __func__);
+        }
+        track.mSample = std::move(sample);
+        RefPtr<DecodePromise> p = track.mPromise.Ensure(__func__);
+        Pump();
+        return p;
+      });
+}
+
+RefPtr<GenericPromise> WebOSEngineChannel::Flush(TrackInfo::TrackType aType) {
+  return InvokeAsync(mTaskQueue, __func__, [self = RefPtr{this}, this, aType] {
+    RejectPending(TrackFor(aType));
+    return GenericPromise::CreateAndResolve(true, __func__);
+  });
+}
+
+#undef LOG
+#undef LOGW
+
+}  // namespace mozilla
diff --git a/dom/media/platforms/webos/WebOSEngine.h b/dom/media/platforms/webos/WebOSEngine.h
new file mode 100644
index 0000000000..2211492258
--- /dev/null
+++ b/dom/media/platforms/webos/WebOSEngine.h
@@ -0,0 +1,184 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef DOM_MEDIA_PLATFORMS_WEBOS_WEBOSENGINE_H_
+#define DOM_MEDIA_PLATFORMS_WEBOS_WEBOSENGINE_H_
+
+#include "ExternalEngineStateMachine.h"
+#include "MediaData.h"
+#include "MediaInfo.h"
+#include "MediaMIMETypes.h"
+#include "MediaTimer.h"
+#include "PlatformDecoderModule.h"
+#include "mozilla/Atomics.h"
+#include "mozilla/MozPromise.h"
+#include "mozilla/TaskQueue.h"
+#include "mozilla/gfx/Rect.h"
+
+namespace mozilla {
+
+/**
+ * One playback through LG webOS's Starfish media pipeline. A helper process
+ * (geckotv --media-helper) drives the pipeline. This class starts the helper,
+ * talks to it over a socketpair and stops it. The ExternalEngineStateMachine
+ * owns a WebOSEngine. The pass-through decoders of WebOSEngineDecoderModule
+ * hand their compressed samples to the channel named by the engine's id.
+ * Everything but the thread-safe getters runs on the channel's task queue,
+ * and the socket is only used there.
+ */
+class WebOSEngineChannel final {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(WebOSEngineChannel)
+
+  using DecodePromise = MediaDataDecoder::DecodePromise;
+
+  explicit WebOSEngineChannel(ExternalEngineStateMachine* aOwner);
+
+  static RefPtr<WebOSEngineChannel> FromId(uint64_t aId);
+
+  uint64_t Id() const { return mId; }
+  TaskQueue* Queue() const { return mTaskQueue; }
+
+  // ExternalPlaybackEngine operations, forwarded by WebOSEngine.
+  RefPtr<GenericNonExclusivePromise> Init(const MediaInfo& aInfo);
+  void Shutdown();
+  bool IsInited() const { return mInited; }
+  void Play();
+  void Pause();
+  void Seek(const media::TimeUnit& aTarget);
+  void SetPlaybackRate(double aRate);
+  void SetVolume(double aVolume);
+  void NotifyEndOfStream(TrackInfo::TrackType aType);
+  void SetVideoRect(const gfx::IntRect& aRect);
+  media::TimeUnit GetCurrentPosition() const {
+    return media::TimeUnit::FromMicroseconds(mPositionUs);
+  }
+
+  // Decoder side. Submit resolves once the sample is handed to the
+  // pipeline, and Flush rejects what is pending.
+  RefPtr<DecodePromise> Submit(TrackInfo::TrackType aType,
+                               RefPtr<MediaRawData> aSample);
+  RefPtr<GenericPromise> Flush(TrackInfo::TrackType aType);
+
+  const MediaInfo& Info() const { return mInfo; }
+
+ private:
+  ~WebOSEngineChannel();
+
+  struct Msg;
+  struct Track {
+    RefPtr<MediaRawData> mSample;
+    MozPromiseHolder<DecodePromise> mPromise;
+    bool mEnded = false;
+    bool mEosSent = false;
+    int64_t mLastFedUs = -1;
+  };
+
+  bool Spawn();
+  bool Open();
+  void ConnectAdapter();
+  void SendAdapterRect(const gfx::IntRect& aRect);
+  bool Request(Msg& aMsg, const void* aPayload, size_t aSize, int aTimeoutMs);
+  bool SendAll(const void* aData, size_t aLen, const TimeStamp& aDeadline);
+  bool RecvAll(void* aData, size_t aLen, const TimeStamp& aDeadline);
+  bool Pump();
+  void Tick();
+  void ScheduleTick();
+  bool FeedOne(Track& aTrack, TrackInfo::TrackType aType);
+  bool SendLoad();
+  bool SendEos(Track& aTrack, TrackInfo::TrackType aType);
+  void HandleReply(const Msg& aReply);
+  void Fail(const MediaResult& aError);
+  void Close();
+  void RejectPending(Track& aTrack);
+  already_AddRefed<MediaData> FakeOutput(TrackInfo::TrackType aType,
+                                         const MediaRawData& aSample);
+  Track& TrackFor(TrackInfo::TrackType aType) {
+    return aType == TrackInfo::kVideoTrack ? mVideo : mAudio;
+  }
+  void NotifyOwner(ExternalEngineEvent aEvent);
+  int64_t LeadUs() const;
+
+  const uint64_t mId;
+  ExternalEngineStateMachine* MOZ_NON_OWNING_REF mOwner;
+  RefPtr<TaskQueue> mTaskQueue;
+  RefPtr<MediaTimer<TimeStamp>> mTimer;
+  MozPromiseRequestHolder<MediaTimerPromise> mTickRequest;
+
+  MediaInfo mInfo;
+  Atomic<bool> mInited{false};
+  Atomic<bool> mOwnerGone{false};
+  Atomic<int64_t> mPositionUs{0};
+
+  int mFd = -1;
+  pid_t mPid = 0;
+  int mAdapterFd = -1;
+  nsCString mWindowId;
+
+  Track mVideo;
+  Track mAudio;
+  bool mPlaying = false;
+  bool mClosed = false;
+  bool mFatal = false;
+  bool mPipelineRequested = false;
+  bool mEverLoaded = false;
+  bool mLoadedReported = false;
+  bool mEndedReported = false;
+  bool mHasFrameSinceLoad = false;
+  int mLastFlags = 0;
+  int mRequestsThisTick = 0;
+  int64_t mLoadTimeUs = 0;
+  int64_t mLastTimeupdateUs = -1;
+  gfx::IntRect mRect;
+  bool mRectSent = false;
+  RefPtr<layers::Image> mImage;
+};
+
+class WebOSEngine final : public ExternalPlaybackEngine {
+ public:
+  explicit WebOSEngine(ExternalEngineStateMachine* aOwner);
+  ~WebOSEngine();
+
+  // True when the launcher set up a helper for this run.
+  static bool IsAvailable();
+  // Unencrypted H.264 or VP9 video with no audio or AAC audio.
+  static bool SupportsFormat(const MediaInfo& aInfo);
+  // The same codecs, for a Media Source type's codecs list.
+  static bool SupportsCodecs(const MediaCodecs& aCodecs);
+
+  RefPtr<GenericNonExclusivePromise> Init(const MediaInfo& aInfo,
+                                          const InitFlagSet& aFlags) override;
+  void Shutdown() override;
+  uint64_t Id() const override { return mChannel->Id(); }
+  bool IsInited() const override { return mChannel->IsInited(); }
+  void Play() override { mChannel->Play(); }
+  void Pause() override { mChannel->Pause(); }
+  void Seek(const media::TimeUnit& aTargetTime) override {
+    mChannel->Seek(aTargetTime);
+  }
+  void SetPlaybackRate(double aPlaybackRate) override {
+    mChannel->SetPlaybackRate(aPlaybackRate);
+  }
+  void SetVolume(double aVolume) override { mChannel->SetVolume(aVolume); }
+  void SetLooping(bool aLooping) override {}
+  void SetPreservesPitch(bool aPreservesPitch) override {}
+  media::TimeUnit GetCurrentPosition() override {
+    return mChannel->GetCurrentPosition();
+  }
+  void NotifyEndOfStream(TrackInfo::TrackType aType) override {
+    mChannel->NotifyEndOfStream(aType);
+  }
+  bool SetCDMProxy(CDMProxy* aProxy) override { return false; }
+  void NotifyResizing(uint32_t aWidth, uint32_t aHeight) override {}
+  void SetVideoRect(const gfx::IntRect& aRect) override {
+    mChannel->SetVideoRect(aRect);
+  }
+
+ private:
+  RefPtr<WebOSEngineChannel> mChannel;
+};
+
+}  // namespace mozilla
+
+#endif  // DOM_MEDIA_PLATFORMS_WEBOS_WEBOSENGINE_H_
diff --git a/dom/media/platforms/webos/WebOSEngineDecoderModule.cpp b/dom/media/platforms/webos/WebOSEngineDecoderModule.cpp
new file mode 100644
index 0000000000..9fc18a1918
--- /dev/null
+++ b/dom/media/platforms/webos/WebOSEngineDecoderModule.cpp
@@ -0,0 +1,164 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "WebOSEngineDecoderModule.h"
+
+#include "Adts.h"
+#include "MP4Decoder.h"
+#include "VPXDecoder.h"
+#include "WebOSEngine.h"
+#include "mozilla/Logging.h"
+
+namespace mozilla {
+
+extern LazyLogModule sPDMLog;
+
+namespace {
+
+class WebOSEngineStream final : public MediaDataDecoder {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(WebOSEngineStream, final);
+
+  WebOSEngineStream(WebOSEngineChannel* aChannel, const TrackInfo& aInfo)
+      : mChannel(aChannel), mInfo(aInfo.Clone()) {}
+
+  RefPtr<InitPromise> Init() override {
+    return InitPromise::CreateAndResolve(mInfo->GetType(), __func__);
+  }
+
+  RefPtr<DecodePromise> Decode(MediaRawData* aSample) override {
+    RefPtr<MediaRawData> sample = aSample;
+    if (mInfo->GetType() == TrackInfo::kAudioTrack) {
+      // The pipeline takes AAC as ADTS frames.
+      const AudioInfo* audio = mInfo->GetAsAudioInfo();
+      if (!ADTS::FrameHeader::MatchesSync(Span{sample->Data(), sample->Size()})) {
+        sample = aSample->Clone();
+        auto index = ADTS::GetFrequencyIndex(audio->mRate);
+        if (!sample || index.isErr() ||
+            !ADTS::ConvertSample(audio->mChannels, index.unwrap(),
+                                 audio->mProfile ? audio->mProfile : 2,
+                                 sample)) {
+          return DecodePromise::CreateAndReject(
+              MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                          RESULT_DETAIL("ADTS conversion failed")),
+              __func__);
+        }
+      }
+    }
+    return mChannel->Submit(mInfo->GetType(), std::move(sample));
+  }
+
+  // At most one sample waits in the channel, and the reader never drains
+  // while one is in flight, so there is nothing to return here.
+  RefPtr<DecodePromise> Drain() override {
+    return DecodePromise::CreateAndResolve(DecodedData(), __func__);
+  }
+
+  RefPtr<FlushPromise> Flush() override {
+    return mChannel->Flush(mInfo->GetType())
+        ->Then(
+            mChannel->Queue(), __func__,
+            [](bool) { return FlushPromise::CreateAndResolve(true, __func__); },
+            [](nsresult) {
+              return FlushPromise::CreateAndResolve(true, __func__);
+            });
+  }
+
+  RefPtr<ShutdownPromise> Shutdown() override {
+    return ShutdownPromise::CreateAndResolve(true, __func__);
+  }
+
+  bool IsHardwareAccelerated(nsACString& aFailureReason) const override {
+    return mInfo->GetType() == TrackInfo::kVideoTrack;
+  }
+
+  nsCString GetDescriptionName() const override {
+    return mInfo->GetType() == TrackInfo::kVideoTrack
+               ? "webos media engine video"_ns
+               : "webos media engine audio"_ns;
+  }
+
+  nsCString GetCodecName() const override {
+    if (MP4Decoder::IsH264(mInfo->mMimeType)) {
+      return "h264"_ns;
+    }
+    if (VPXDecoder::IsVP9(mInfo->mMimeType)) {
+      return "vp9"_ns;
+    }
+    return "aac"_ns;
+  }
+
+  ConversionRequired NeedsConversion() const override {
+    return MP4Decoder::IsH264(mInfo->mMimeType)
+               ? ConversionRequired::kNeedAnnexB
+               : ConversionRequired::kNeedNone;
+  }
+
+  bool ShouldDecoderAlwaysBeRecycled() const override { return true; }
+
+ private:
+  ~WebOSEngineStream() = default;
+
+  RefPtr<WebOSEngineChannel> mChannel;
+  UniquePtr<TrackInfo> mInfo;
+};
+
+bool CodecSupported(const nsACString& aMimeType) {
+  return MP4Decoder::IsH264(aMimeType) || VPXDecoder::IsVP9(aMimeType) ||
+         MP4Decoder::IsAAC(aMimeType);
+}
+
+already_AddRefed<MediaDataDecoder> CreateStream(
+    const CreateDecoderParams& aParams) {
+  if (!aParams.mMediaEngineId || !CodecSupported(aParams.mConfig.mMimeType)) {
+    return nullptr;
+  }
+  RefPtr<WebOSEngineChannel> channel =
+      WebOSEngineChannel::FromId(*aParams.mMediaEngineId);
+  if (!channel) {
+    MOZ_LOG(sPDMLog, LogLevel::Warning,
+            ("WebOSEngineDecoderModule: no engine %" PRIu64,
+             *aParams.mMediaEngineId));
+    return nullptr;
+  }
+  RefPtr<MediaDataDecoder> decoder =
+      new WebOSEngineStream(channel, aParams.mConfig);
+  return decoder.forget();
+}
+
+}  // namespace
+
+/* static */
+already_AddRefed<PlatformDecoderModule> WebOSEngineDecoderModule::Create() {
+  RefPtr<WebOSEngineDecoderModule> module = new WebOSEngineDecoderModule();
+  return module.forget();
+}
+
+already_AddRefed<MediaDataDecoder> WebOSEngineDecoderModule::CreateVideoDecoder(
+    const CreateDecoderParams& aParams) {
+  return CreateStream(aParams);
+}
+
+already_AddRefed<MediaDataDecoder> WebOSEngineDecoderModule::CreateAudioDecoder(
+    const CreateDecoderParams& aParams) {
+  return CreateStream(aParams);
+}
+
+media::DecodeSupportSet WebOSEngineDecoderModule::SupportsMimeType(
+    const nsACString& aMimeType, DecoderDoctorDiagnostics* aDiagnostics) const {
+  // Only reachable through Supports() with an engine id.
+  return media::DecodeSupportSet{};
+}
+
+media::DecodeSupportSet WebOSEngineDecoderModule::Supports(
+    const SupportDecoderParams& aParams,
+    DecoderDoctorDiagnostics* aDiagnostics) const {
+  if (!aParams.mMediaEngineId || !CodecSupported(aParams.MimeType())) {
+    return media::DecodeSupportSet{};
+  }
+  return aParams.mConfig.IsVideo() ? media::DecodeSupport::HardwareDecode
+                                   : media::DecodeSupport::SoftwareDecode;
+}
+
+}  // namespace mozilla
